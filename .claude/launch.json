{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && API_PORT=3001 npx vite preview --config vite.config.ts --port 4173"
      ],
      "port": 4173
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx vite --config vite.config.ts --port 5173"
      ],
      "port": 5173
    }
  ]
}