# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=3000

# Required
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google / YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram publishing (Meta app with Instagram + Facebook Login products).
# See docs/INSTAGRAM_PUBLISHING.md for the full setup.
META_APP_ID=
META_APP_SECRET=
# Must match a Valid OAuth Redirect URI in the Meta app, exactly.
INSTAGRAM_REDIRECT_URI=https://layer-1.onrender.com/api/integrations/instagram/callback
# Optional — defaults to v21.0
META_GRAPH_VERSION=

# Email (at least one provider)
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# Optional
EMAIL_VERIFY_API_KEY=
PLATFORM_WALLET_ADDRESS=
SOLANA_CLUSTER=devnet
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
PLATFORM_WALLET_PRIVATE_KEY=
