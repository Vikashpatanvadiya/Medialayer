{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "push": "dotenv -e .env -- drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "dotenv -e .env -- drizzle-kit push --config ./drizzle.config.ts --force",
    "studio": "dotenv -e .env -- drizzle-kit studio --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.7.0",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.11.14",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "catalog:"
  }
}
